# Application
APP_NAME=Core HIS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=his_user
POSTGRES_PASSWORD=his_password
POSTGRES_DB=his_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Database Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false

# Application-Level Encryption (Fernet url-safe base64 32-byte key)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_CACHE_TTL_SECONDS=3600
ROUTING_RULES_CACHE_TTL_SECONDS=1800
